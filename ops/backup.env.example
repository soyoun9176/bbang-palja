# Copy outside Git to a mode-0600 file. Never paste real credentials into this file.
# DB_PATH and DATABASE_URL come from the existing api.env; do not override them here.
BACKUP_BACKEND=gdrive
BACKUP_STATE_DIR=/var/lib/bbang-palja-backup
BACKUP_APP_DIR=/opt/bbang-palja/app
BACKUP_PREFIX=cambo-delight/production
BACKUP_RCLONE_BIN=/usr/local/lib/bbang-palja-backup/rclone
BACKUP_RCLONE_CONFIG=/var/lib/bbang-palja-backup/gdrive/rclone.conf
# rclone.conf must set root_folder_id to the dedicated backup folder ID.
BACKUP_DRIVE_REMOTE=cambo-backup:
# Five-minute backups: keep about one hour in detail plus 48 hourly snapshots.
BACKUP_KEEP_RECENT=12
BACKUP_KEEP_HOURLY=48
BACKUP_MAX_DB_BYTES=268435456
BACKUP_SNAPSHOT_TIMEOUT=45
BACKUP_STALE_SECONDS=900
